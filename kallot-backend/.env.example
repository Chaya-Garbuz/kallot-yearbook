# העתיקי את הקובץ הזה לקובץ בשם .env ומלאי ערכים אמיתיים. אל תעלי את .env ל־GitHub.

# כתובת מסד הנתונים (PostgreSQL). דוגמה למחשב מקומי:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kallot?schema=public"

# מחרוזת סודית ארוכה (32 תווים לפחות). אפשר ליצור אחת עם: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-secret-at-least-32-characters"

# תוקף הכניסה (7d = שבעה ימים)
JWT_EXPIRES_IN="7d"

PORT=4000
NODE_ENV=development

# כתובות האתר בריאקט שמותר להן לפנות לשרת, מופרדות בפסיק
CORS_ORIGINS="http://localhost:5173"

# הכתובת הציבורית של השרת ושל האתר (לקישורים במיילים)
PUBLIC_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:5173"

# מיילים: לא חובה. בלי מפתח, המיילים רק נרשמים בטבלת EmailLog ובלוג.
RESEND_API_KEY=
EMAIL_FROM="שנתון הכלות <onboarding@resend.dev>"

# משימות מתוזמנות (תזכורות, דיוור). false כדי לכבות
ENABLE_JOBS=true
TIMEZONE="Asia/Jerusalem"

# לנתוני הדגמה ב־Production בלבד (לא חובה)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
