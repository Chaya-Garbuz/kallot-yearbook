// מסד הנתונים של שנתון הכלות
// כל התאריכים של אירוסין וחתונה נשמרים כתאריך בלבד (בלי שעה)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  REP
  GRADUATE
}

enum UserStatus {
  PENDING
  ACTIVE
  BLOCKED
}

enum BlessingEmailPref {
  EACH
  DAILY
  NONE
}

enum RequestType {
  NEW
  UPDATE
}

enum RequestStatus {
  PENDING
  APPROVED
  DECLINED
}

enum ReminderTiming {
  BEFORE
  DAY
  BOTH
}

enum ArticleTopic {
  PREPARATIONS
  HOME
  FINANCE
  RECIPES
  NEWS
}

enum EmailStatus {
  SENT
  LOGGED
  FAILED
}

// שנתון / מחזור
model Yearbook {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(80)
  hebrewYear  String   @db.VarChar(20)
  joinCode    String   @unique @db.VarChar(30)
  timezone    String   @default("Asia/Jerusalem")
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  classes         ClassGroup[]
  specializations Specialization[]
  users           User[]
  announcements   Announcement[]
}

// כיתה
model ClassGroup {
  id         String   @id @default(uuid())
  yearbookId String
  name       String   @db.VarChar(20)
  size       Int
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  yearbook      Yearbook        @relation(fields: [yearbookId], references: [id], onDelete: Cascade)
  kallot        Kalla[]
  users         User[]
  requests      UpdateRequest[]
  announcements Announcement[]

  @@unique([yearbookId, name])
}

// התמחות (חוצה כיתות)
model Specialization {
  id         String   @id @default(uuid())
  yearbookId String
  name       String   @db.VarChar(40)
  size       Int
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  yearbook Yearbook @relation(fields: [yearbookId], references: [id], onDelete: Cascade)
  kallot   Kalla[]

  @@unique([yearbookId, name])
}

// משתמשת
model User {
  id                 String            @id @default(uuid())
  yearbookId         String
  classId            String?
  name               String            @db.VarChar(30)
  email              String            @unique @db.VarChar(120)
  passwordHash       String
  role               Role              @default(GRADUATE)
  status             UserStatus        @default(PENDING)
  blessingEmailPref  BlessingEmailPref @default(DAILY)
  reminderEmails     Boolean           @default(true)
  announcementEmails Boolean           @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  yearbook       Yearbook                @relation(fields: [yearbookId], references: [id], onDelete: Cascade)
  classGroup     ClassGroup?             @relation(fields: [classId], references: [id], onDelete: SetNull)
  kalla          Kalla?                  @relation("KallaUser")
  requests       UpdateRequest[]         @relation("RequestAuthor")
  reviewed       UpdateRequest[]         @relation("RequestReviewer")
  reminders      ReminderSubscription[]
  newsletter     NewsletterSubscription?
  blessings      Blessing[]              @relation("BlessingAuthor")
  articles       Article[]
  announcements  Announcement[]
  createdKallot  Kalla[]                 @relation("KallaCreatedBy")
  updatedKallot  Kalla[]                 @relation("KallaUpdatedBy")
  hiddenBlessing Blessing[]              @relation("BlessingHiddenBy")

  @@index([yearbookId, classId])
}

// ישיבה
model Yeshiva {
  id         String   @id @default(uuid())
  name       String   @unique @db.VarChar(60)
  aliases    String[] @default([])
  isApproved Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  kallot Kalla[]
}

// כלה - האובייקט המרכזי
model Kalla {
  id               String    @id @default(uuid())
  classId          String
  specializationId String
  yeshivaId        String
  userId           String?   @unique
  name             String    @db.VarChar(40)
  engagedAt        DateTime  @db.Date
  weddingAt        DateTime? @db.Date
  hallName         String?   @db.VarChar(60)
  hallCity         String?   @db.VarChar(30)
  hideWeddingDate  Boolean   @default(false)
  createdById      String?
  updatedById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  classGroup     ClassGroup             @relation(fields: [classId], references: [id], onDelete: Restrict)
  specialization Specialization         @relation(fields: [specializationId], references: [id], onDelete: Restrict)
  yeshiva        Yeshiva                @relation(fields: [yeshivaId], references: [id], onDelete: Restrict)
  user           User?                  @relation("KallaUser", fields: [userId], references: [id], onDelete: SetNull)
  createdBy      User?                  @relation("KallaCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy      User?                  @relation("KallaUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  reminders      ReminderSubscription[]
  blessings      Blessing[]

  @@unique([classId, name])
  @@index([weddingAt])
  @@index([yeshivaId])
  @@index([specializationId])
}

// דיווח עצמי של בוגרת
model UpdateRequest {
  id           String        @id @default(uuid())
  userId       String
  classId      String
  type         RequestType
  data         Json
  status       RequestStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  note         String?       @db.VarChar(200)
  createdAt    DateTime      @default(now())

  user       User       @relation("RequestAuthor", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User?      @relation("RequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  classGroup ClassGroup @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId, status])
}

// מינוי לתזכורת על חתונה
model ReminderSubscription {
  id           String         @id @default(uuid())
  userId       String
  kallaId      String
  timing       ReminderTiming
  sentBeforeAt DateTime?
  sentDayAt    DateTime?
  createdAt    DateTime       @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  kalla Kalla @relation(fields: [kallaId], references: [id], onDelete: Cascade)

  @@unique([userId, kallaId])
}

// מינוי לדיוור
model NewsletterSubscription {
  id               String         @id @default(uuid())
  userId           String         @unique
  topics           ArticleTopic[]
  isActive         Boolean        @default(true)
  unsubscribeToken String         @unique @default(uuid())
  lastSentAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ברכה באלבום האיחולים
model Blessing {
  id         String    @id @default(uuid())
  kallaId    String
  authorId   String
  text       String    @db.VarChar(500)
  color      String    @default("gold") @db.VarChar(20)
  isHidden   Boolean   @default(false)
  hiddenById String?
  emailedAt  DateTime?
  editedAt   DateTime?
  createdAt  DateTime  @default(now())

  kalla    Kalla @relation(fields: [kallaId], references: [id], onDelete: Cascade)
  author   User  @relation("BlessingAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  hiddenBy User? @relation("BlessingHiddenBy", fields: [hiddenById], references: [id], onDelete: SetNull)

  @@index([kallaId, createdAt])
}

// דף מידע
model Article {
  id          String       @id @default(uuid())
  title       String       @db.VarChar(100)
  slug        String       @unique @db.VarChar(100)
  topic       ArticleTopic
  body        String
  isPublished Boolean      @default(false)
  authorId    String?
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)
}

// הודעה לשנתון או לכיתה
model Announcement {
  id              String   @id @default(uuid())
  yearbookId      String
  classId         String?
  subject         String   @db.VarChar(80)
  body            String   @db.VarChar(2000)
  sentById        String
  recipientsCount Int      @default(0)
  sentAt          DateTime @default(now())

  yearbook   Yearbook    @relation(fields: [yearbookId], references: [id], onDelete: Cascade)
  classGroup ClassGroup? @relation(fields: [classId], references: [id], onDelete: SetNull)
  sentBy     User        @relation(fields: [sentById], references: [id], onDelete: Cascade)
}

// תיעוד מיילים
model EmailLog {
  id       String      @id @default(uuid())
  to       String      @db.VarChar(120)
  template String      @db.VarChar(40)
  subject  String      @db.VarChar(200)
  status   EmailStatus
  error    String?
  sentAt   DateTime    @default(now())

  @@index([sentAt])
}
